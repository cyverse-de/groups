    "definitions": {
        "main.StatusResponse": {
            "type": "object",
            "properties": {
                "database": {
                    "description": "Database reports whether group storage is reachable. False means the\nservice cannot serve any group request.",
                    "type": "boolean"
                },
                "keycloak": {
                    "description": "Keycloak reports whether user attributes are reachable. False degrades\nnames and email addresses but leaves group membership working.",
                    "type": "boolean"
                },
                "service": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            }
        },
        "main.groupListResponse": {
            "type": "object",
            "properties": {
                "groups": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Group"
                    }
                }
            }
        },
        "main.groupPermission": {
            "type": "object",
            "properties": {
                "level": {
                    "type": "string"
                },
                "subject": {
                    "$ref": "#/definitions/permissions.Subject"
                }
            }
        },
        "main.groupPermissionsResponse": {
            "type": "object",
            "properties": {
                "permissions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.groupPermission"
                    }
                }
            }
        },
        "main.groupRequest": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "display_name": {
                    "type": "string"
                },
                "group_type": {
                    "type": "string"
                },
                "joinable": {
                    "description": "Joinable lets a user add themselves without approval. Distinct from\nMembersPublic: Grouper's `optins` rather than `readers`.",
                    "type": "boolean"
                },
                "members_public": {
                    "description": "MembersPublic makes a public group's member list public too. Meaningless\nunless the group is also granted read to the public subject.",
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "owner": {
                    "type": "string"
                }
            }
        },
        "main.groupUpdateRequest": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "display_name": {
                    "type": "string"
                },
                "joinable": {
                    "type": "boolean"
                },
                "members_public": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "main.lookupRequest": {
            "type": "object",
            "properties": {
                "subject_ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "main.memberResult": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "source_id": {
                    "type": "string"
                },
                "subject_id": {
                    "type": "string"
                },
                "subject_name": {
                    "type": "string"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "main.membersRequest": {
            "type": "object",
            "properties": {
                "members": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "main.membersResponse": {
            "type": "object",
            "properties": {
                "members": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Subject"
                    }
                },
                "redacted": {
                    "description": "Redacted marks a member list withheld because the group is public but\nits membership is not. Without it an empty list is indistinguishable\nfrom a genuinely empty group, and a service that reconciles state from\nthis endpoint -- group-propagator replaces iRODS ACLs from it -- treats\nthe redaction as truth and deletes every member.",
                    "type": "boolean"
                }
            }
        },
        "main.membersResults": {
            "type": "object",
            "properties": {
                "results": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.memberResult"
                    }
                }
            }
        },
        "main.permissionRequest": {
            "type": "object",
            "properties": {
                "level": {
                    "type": "string"
                }
            }
        },
        "main.subjectsResponse": {
            "type": "object",
            "properties": {
                "subjects": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Subject"
                    }
                }
            }
        },
